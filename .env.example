# Mia — Expert Engineer & Personal Companion
# Copy to .env and fill in values. Never commit .env.

# --- Backend ---
MIA_ENV=development
MIA_SECRET_KEY=change-me-to-a-long-random-string
MIA_API_HOST=0.0.0.0
MIA_API_PORT=8000

# --- Database (PostgreSQL via docker-compose) ---
DATABASE_URL=postgresql+psycopg2://mia:mia_password@postgres:5432/mia
# Local fallback without docker:
# DATABASE_URL=sqlite:///./mia.db

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Ollama / Qwen (local code + logic model) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Alternative larger local model:
# OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=120

# --- Hugging Face (visual: FLUX.2-klein 4B / Qwen-Image) ---
HUGGINGFACE_API_KEY=hf_xxx_your_key_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# Alternatives:
# HF_IMAGE_MODEL=Qwen/Qwen-Image-2512
HF_IMAGE_ENDPOINT=https://api-inference.huggingface.co/models/black-forest-labs/FLUX.2-klein-4B

# --- Notifications / Reminders ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GENERIC_WEBHOOK_URL=
DESKTOP_NOTIFY_ENABLED=true

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000
